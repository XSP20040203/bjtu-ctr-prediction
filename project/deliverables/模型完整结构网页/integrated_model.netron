          "attributes": [
            {
              "name": "结构01",
              "type": "string",
              "value": "existing = z − 组均值z"
            },
            {
              "name": "结构02",
              "type": "string",
              "value": "ranked = 树分数减组均值 再与existing标准差对齐"
            },
            {
              "name": "结构03",
              "type": "string",
              "value": "add_within 为 S[z + w ranked]  replace_within 为 S[z + w(ranked−existing)]"
            }
          ]
        },
