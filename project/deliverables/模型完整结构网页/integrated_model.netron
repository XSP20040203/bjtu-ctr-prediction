      "nodes": [
        {
          "name": "用户日期对齐与原始行序保留",
          "type": {
            "name": "用户日期对齐与原始行序保留",
            "category": "Data",
            "graph": "四张表怎样对齐成模型输入"
          },
          "description": "同一个用户一天里可能看到很多条广告，也可能看过很多条资讯。先把资讯汇总成“这个用户这一天是什么状态”，再把这份状态复制给当天属于他的每条广告。这样连接不会把广告行数越连越多。\n\n训练标签单独保存。预测日广告标签不进入特征；历史点击统计只读预测日以前的真实广告反馈。同日无标签广告曝光数和给定资讯反馈的使用条件与线上逐次预测并不相同。",
          "inputs": [
            {
              "name": "输入1",
              "value": [
                0
              ]
            },
            {
              "name": "输入2",
              "value": [
                1
              ]
            },
            {
              "name": "输入3",
              "value": [
                2
              ]
            },
            {
              "name": "输入4",
              "value": [
                3
              ]
            }
          ],
          "outputs": [
            {
              "name": "输出",
              "value": [
                4
              ]
            }
          ],
          "attributes": [
            {
              "name": "连接键",
              "type": "string",
              "value": "user_id ↔ u_userId；pt_d ↔ e_et"
            },
            {
              "name": "资讯",
              "type": "string",
              "value": "先按用户日聚合再连接"
            },
            {
              "name": "原始行",
              "type": "string",
              "value": "重复曝光保留；group_index 为 N×1"
            }
          ]
        },
        {
          "name": "类别索引与无序历史列表准备",
          "type": {
            "name": "类别索引与无序历史列表准备",
            "category": "Data",
            "graph": "类别和历史列表怎样变成三百一十二维"
          },
          "description": "嵌入表可以理解成一本“编号到数字描述”的字典。任务编号本身没有大小含义，把它查成 8 个可学习的数后，模型才能学出哪些任务的表现接近。相同实体类型的当前候选与历史项共用字典。\n\nPAD 编号为 0，未知编号为 1。某些模型还把用户、任务和广告编号向量的读取范数限制为 0.2，减少只靠记住编号得到高分的倾向。均值池化保留总体兴趣，没有为五个位置添加时间先后含义。",
          "inputs": [
            {
              "name": "输入",
              "value": [
                4
              ]
            }
          ],
          "outputs": [
            {
              "name": "输出",
              "value": [
                5
              ]
            }
          ],
          "attributes": [
            {
              "name": "索引输入",
              "type": "string",
              "value": "27单值 + 12列表×最多5项 = 87个编号"
            },
            {
              "name": "成员嵌入",
              "type": "string",
              "value": "各成员查自己的嵌入表，27×8+12×8=312"
            },
            {
              "name": "列表",
              "type": "string",
              "value": "只平均有效项；PAD=0；UNK=1"
            },
            {
              "name": "权重",
              "type": "string",
              "value": "各网络的312维表示宽度相同，训练权重独立"
            }
          ]
        },
        {
          "name": "多套数值与表格特征组装",
          "type": {
            "name": "多套数值与表格特征组装",
            "category": "Transform",
            "graph": "输入字段和数值特征的具体组成"
          },
          "description": "27 个类别具体包括：用户编号、年龄、性别、居住地、城市、城市等级；设备系列与分组、设备型号与名称、屏幕尺寸、网络类型；任务、广告编号、创意类型、广告主、交互类型、广告位、推广应用、应用标签、二级分类、应用评分；刷新次数、资讯生命周期、手机价格档、浏览器生命周期、浏览器模式。\n\n历史统计里常见的数包括曝光数、点击数、平滑点击率、候选是否出现在历史中、距离上次活跃的天数，以及相对个人过去状态的变化。500 维和 535 维来自两份实际特征清单，不能把它们理解成同一份向量截取前若干列。",
          "inputs": [
            {
              "name": "输入",
