              ]
            }
          ],
          "attributes": [
            {
              "name": "输入",
              "type": "string",
              "value": "535×4 + 312 = 2452"
            },
            {
              "name": "结构",
              "type": "string",
              "value": "4成员；两层128；Dropout 0.15"
            },
            {
              "name": "输出",
              "type": "string",
              "value": "每成员Sigmoid后平均"
            }
          ]
        },
        {
          "name": "丰富历史门控低秩多专家深度交叉网络",
          "type": {
            "name": "丰富历史门控低秩多专家深度交叉网络",
            "category": "Layer",
            "graph": "字段门控与低秩多专家交叉网络"
          },
          "description": "门控像给每类资料分配音量：当日资讯状态会影响模型更看重哪类字段。39 个增益分别作用于 39 个字段，不会删掉字段，也不会把 312 维变成 39 维。\n\n每个交叉专家先把大向量压成 32 维，再做一次 32 维变换，最后展开回原宽度。三个专家的比例由门控前的原始内容决定。166 数值成员用于日状态保护网络；500 数值成员作为丰富历史网络独立参加融合。",
          "inputs": [
            {
              "name": "输入1",
              "value": [
                5
              ]
            },
            {
              "name": "输入2",
              "value": [
                6
              ]
            }
          ],
          "outputs": [
            {
              "name": "输出",
              "value": [
                14
              ]
            }
          ],
          "attributes": [
            {
              "name": "输入",
              "type": "string",
              "value": "312 + 500 = 812"
            },
            {
              "name": "字段门控",
              "type": "string",
              "value": "55→16→39→2×Sigmoid"
            },
            {
              "name": "交叉 ∥ 深层",
              "type": "string",
              "value": "2层×3专家；D→32→32→D ∥ D→128→64"
            },
            {
              "name": "输出",
              "type": "string",
              "value": "拼876→1→Sigmoid"
            }
          ]
        },
        {
          "name": "用户日无广告标签上下文",
          "type": {
            "name": "用户日无广告标签上下文",
            "category": "Data",
            "graph": "用户日状态保护网络的完整结构"
          },
          "description": "日级分支先理解“这个用户今天整体上想不想互动”，再给每条广告一个最多正负 2 的原始分数调整。G 行状态通过组索引送给 N 条广告，而不是把用户日数当成广告条数。\n\n辅助任务用来帮助学好 32 维状态，不是预测时额外提供一个真实点击答案。辅助路径停止用户嵌入梯度，主干与日级头分别做梯度裁剪，裁剪范数为 5。三份检查点结构同类，训练目标和保存权重不同。",
          "inputs": [
            {
