        {
          "name": "冻结神经字典与候选历史关系",
          "type": {
            "name": "冻结神经字典与候选历史关系",
            "category": "Layer",
            "graph": "冻结神经表示怎样构造一百三十八维"
          },
          "description": "冻结表示是把网络已经学到的数字关系抽出来，交给树模型使用。树训练只学习怎样利用这些数，不会反向更新教师。这里的教师不是逐日折外教师，因此不能把这份表示称为逐日折外特征。\n\n逐元素乘积会留下 8 个坐标，而点积会把这 8 个乘积加成 1 个数。所以同样是比较两个向量，前者贡献 8 维，后者贡献 1 维。两者同时保留时不能漏数。",
          "inputs": [
            {
              "name": "输入",
              "value": [
                4
              ]
            }
          ],
          "outputs": [
            {
              "name": "输出",
              "value": [
                82
              ]
            }
          ],
          "attributes": [
            {
              "name": "当前向量",
              "type": "string",
              "value": "6×8=48；历史均值6×8=48"
            },
            {
              "name": "交互",
              "type": "string",
              "value": "用户候选逐元素乘积4×8=32"
            },
            {
              "name": "点积",
              "type": "string",
              "value": "6历史候选 + 4用户候选"
            },
            {
              "name": "总宽",
              "type": "string",
              "value": "48+48+32+6+4=138；教师检查点字典冻结"
            }
          ]
        },
